rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coleções para o Estúdio de Tatuagem
    match /tatuador/{document} {
      allow create, read: if true;
      allow write, delete: if true;
    }

    match /agendamento/{document} {
      allow create, read: if true;
      allow write, delete: if true;
    }

    // Compatibilidade com coleções anteriores
    match /integrante/{document} {
      allow create, read: if true;
      allow write, delete: if true;
    }

    match /atividade/{document} {
      allow create, read: if true;
      allow write, delete: if true;
    }
  }
}
