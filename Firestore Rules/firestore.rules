rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coleções para o Sistema da Locadora de Filmes
    match /filme/{document} {
      allow create, read: if true;
      allow write, delete: if true;
    }

    match /locacao/{document} {
      allow create, read: if true;
      allow write, delete: if true;
    }

    // Compatibilidade com coleções anteriores
    match /{document=**} {
      allow create, read: if true;
      allow write, delete: if true;
    }
  }
}
